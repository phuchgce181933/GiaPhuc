{
  "name": "giaphuc-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Gia Phuc backend (Express + MongoDB).",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/scripts/seed.js",
    "test": "node --require ./tests/setup.cjs --test --test-concurrency=1 tests/timetable/*.test.js",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "http-errors": "^2.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.14",
    "zod": "^3.23.8",
    "bson": "^6.10.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
