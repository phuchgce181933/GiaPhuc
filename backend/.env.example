# --- Runtime ---
NODE_ENV=development
PORT=5001

# --- MongoDB ---
MONGODB_URI=your_mongodb_connection_string
MONGODB_DB=giaphuc

# Timetable data MUST use a different database. The URI can point to the same
# MongoDB server or a separate server; it never uses the GiaPhuc connection.
# Unset TKB_MONGODB_URI to reuse only the server URI with this separate dbName.
# TKB_MONGODB_URI=your_other_mongodb_connection_string
TKB_MONGODB_DB=thuanhung_tkb
TKB_TRANSFER_POLICY=AUTO_SHORTAGE
TKB_PREVIEW_LIMIT=6
# 0 means no preview expiry.
TKB_PREVIEW_TTL_SECONDS=0

# Optional AI parser (OpenAI Responses API). Leave both empty for local parsing.
# Backend-only secret; never configure an API key in the frontend.
TKB_AI_API_KEY=
TKB_AI_MODEL=
TKB_ASSISTANT_TTL_SECONDS=900

# --- JWT ---
JWT_SECRET=replace_with_a_long_random_string_at_least_64_hex_chars
JWT_REFRESH_SECRET=replace_with_another_long_random_string_at_least_64_hex_chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# --- Mail (SMTP) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=your_smtp_user
MAIL_PASS=your_smtp_password_or_app_password
MAIL_FROM_NAME=Gia Phuc System
MAIL_FROM_EMAIL=your_smtp_user@example.com

# --- URLs ---
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5001

# Presentations use an independent MongoDB database. Same server is allowed.
PRESENTATION_MONGODB_URI=
PRESENTATION_MONGODB_DB=presentations
# Existing ModelAPI-compatible endpoint for slide outline generation.
MODEL_API_URL=https://modelapi.vn/v1/chat/completions
MODEL_API_KEY=
MODEL_API_MODEL=gpt-5.4
# 32 random bytes, hex encoded; encrypts per-user OAuth tokens stored in MongoDB.
PRESENTATION_TOKEN_ENCRYPTION_KEY=
# Canva REST API app credentials (OAuth 2.0 PKCE; backend only).
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=http://localhost:5001/api/presentations/canva/callback
CANVA_SCOPES=design:content:write design:content:read

# --- Seed admin (used by `npm run seed`) ---
SEED_ADMIN_EMAIL=admin@giaphuc.local
SEED_ADMIN_PASSWORD=ChangeMe@12345
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_PHONE=+840901234567
SEED_ADMIN_USERNAME=admin
# 32 random bytes as hex; use a secrets manager in production.
PRESENTATION_TOKEN_ENCRYPTION_KEY=
