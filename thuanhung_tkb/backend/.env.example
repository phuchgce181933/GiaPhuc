# Port the Express API listens on.
PORT=4010

# Where authoritative fixtures live.
FIXTURE_DIR=../../data/fixtures

# MongoDB connection string. When unset, the loader uses the fixture.
# MONGODB_URI=

# Path to a JSON file containing the full SchedulingInput. When
# set, the loader reads this file instead of the fixture. The file
# is the operator's responsibility; the loader does not invent data.
# DATASET_PATH=../../data/dataset.json
