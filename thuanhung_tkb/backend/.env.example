# Port the Express API listens on.
PORT=4010

# Operator-owned catalog CRUD changes. Relative to backend/src.
# The immutable legacy BSON dump is never modified.
# CATALOG_DATA_DIR=data/catalog

# Home teaching first, then automatic eligible-teacher transfers to cover
# shortages and balance subject workloads. Preferences are soft. Existing
# non-empty allowedTransferBranches lists remain explicit restrictions.
# Set EXPLICIT to require declared permission for every external branch.
TRANSFER_POLICY=AUTO_SHORTAGE

# Where authoritative fixtures live.
FIXTURE_DIR=../../data/fixtures

# MongoDB connection string. When unset, the loader uses the fixture.
# MONGODB_URI=

# Path to a JSON file containing the full SchedulingInput. When
# set, the loader reads this file instead of the fixture. The file
# is the operator's responsibility; the loader does not invent data.
# DATASET_PATH=../../data/dataset.json

# ============================================================================
# SCHEDULE COMMIT (Phase 33)
# ============================================================================
#
# Where a COMMITTED timetable is written. Generate does not write
# here; only POST /api/schedules/commit does, and only after the
# selected solution passes re-validation.
#
# Relative paths resolve from the backend package root. The directory
# is created if it does not exist. It is gitignored: these are
# operational data, not source.
#
# This project has no database driver. The store is a directory of
# JSON documents written with a create-if-absent link, which makes a
# commit atomic and a repeat commit idempotent. See
# docs/PHASE_33_SCHEDULE_COMMIT_PERSISTENCE.md for the driver
# boundary and the MongoDB migration path.
# PERSISTENCE_DIR=data/schedules

# ============================================================================
# AI STRATEGY LAYER (Phase 29/30)
# ============================================================================
#
# The default is `mock`, which is fully deterministic, needs no
# Python, no GPU, and no model. `npm test` therefore passes on a
# machine that has never installed AirLLM. Set `airllm` only on a host
# that actually runs the Python service.

# Which AIPlanner implementation to use: mock | airllm
AI_PROVIDER=mock

# Ceiling for a single AI strategy call, in milliseconds. On timeout
# the deterministic fallback runs and the solver is unaffected.
AI_REQUEST_TIMEOUT_MS=30000

# --- AirLLM local service (Phase 30) ---------------------------------------
# Loopback only. A non-loopback host is refused by the client rather
# than dialled, because the service holds model weights.
AIRLLM_SERVICE_URL=http://127.0.0.1:8077

# Optional internal shared secret. Sent as a bearer token on /plan and
# never logged. Uncomment and set a real value to require it.
# AIRLLM_SERVICE_TOKEN=

# Set to 1 to enable tests/integration/airllm/. Unset or 0 means those
# tests skip; they never fail a default run.
# AIRLLM_INTEGRATION=

# The remaining AIRLLM_* model settings are read by the PYTHON
# service, not by Node. They are documented in ai-service/README.md
# and belong in the Python process's environment, because they
# describe a model that only Python loads.

# --- Schedule persistence (Phases 33 and 34) ------------------------------
# Where committed schedules and their previews are written. Relative
# paths resolve against `backend/src`, so the default lands in
# `backend/src/data/schedules/`.
#
# The directory is gitignored and is recreated on start: deleting it
# loses committed schedules AND the previews an open tab is showing,
# and nothing else.
# PERSISTENCE_DIR=data/schedules

# How many generations of preview to keep. A preview holds three
# solver candidates -- about 0.5 MB of JSON on the real dataset -- so
# this is a disk bound rather than a cache size. Oldest first.
#
# The bound applies to the SHEDDABLE set. A preview that has already
# produced a committed schedule is never shed, so the directory can
# sit one above this number rather than evicting a commit the user
# already made.
# PREVIEW_LIMIT=6

# How long a stored generation stays committable, in seconds.
#
# UNSET MEANS NO EXPIRY, and that is the deliberate default rather
# than an unimplemented feature: a preview that expires with nobody
# having asked for it turns an open browser tab into a 410 the user
# cannot explain, and "the timetable I was looking at is gone" is a
# worse answer than a few megabytes of JSON on disk.
#
# Set it and every record carries the `expiresAt` that was applied, so
# the policy is readable from the data afterwards. `GET
# /api/schedules/health` reports `preview.expiration` as `NONE` or
# `TTL_CONFIGURED`.
#
# Because the choice is consequential, it is documented in
# docs/PHASE_34_PERSISTENCE_HARDENING.md §5 rather than left to a
# default that nobody made.
# PREVIEW_TTL_SECONDS=
